@model System.Data.DataTable
<h1 class="text-center">CRUD APPLICATION</h1>
<a class="btn btn-primary" asp-action="index">Add data</a>
<br />
<table class="table table-striped my-2">
    <thead>
        <tr class="table-active">
            <th class="text-center">Id</th>
            <th class="text-center">Name</th>
            <th class="text-center">Email</th>
            <th class="text-center">Password</th>
            <th class="text-center">Address</th>
            <th class="text-center">Number</th>
            <th class="text-center">City</th>
            <th class="text-center">Province</th>
            <th class="text-center">Update</th>
            <th class="text-center">Delete</th>
            <th>Details</th>

        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (System.Data.DataRow row in Model.Rows)
            {
                <tr>
                    <td class="text-center">@row["Id"]</td>
                    <td class="text-center">@row["Name"]</td>
                    <td class="text-center">@row["Email"]</td>
                    <td class="text-center">@row["Password"]</td>
                    <td class="text-center">@row["Address"]</td>
                    <td class="text-center">@row["Number"]</td>
                    <td class="text-center">@row["City"]</td>
                    <td class="text-center">@row["Province"]</td>
                    <td>
                        <a asp-controller="home" asp-action="getdata_form" asp-route-id="@row["Id"]" class="btn btn-primary">Edit</a>
                    </td>
                    <td>
                        <a asp-action="Check_delete" asp-route-id="@row["id"]" class="btn btn-danger">Delete</a>
                    </td>
                    <td>
                        <a asp-controller="home" asp-action="Details"  class="btn btn-warning" asp-route-id="@row["id"]">Details</a>
                    </td>
                    
                </tr>
            }
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index">Back To Home</a>
</div>